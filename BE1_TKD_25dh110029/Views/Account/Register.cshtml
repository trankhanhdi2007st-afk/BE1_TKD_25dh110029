

@model BE1_TKD_25dh110029.Models.ViewModel.RegisterVM

@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<style>
    .account-page {
        background: #FFFDF5;
        min-height: 650px;
        padding: 55px 15px;
    }

    .account-card {
        max-width: 600px;
        margin: auto;
        background: white;
        padding: 35px 40px;
        border: 1px solid #E8DCA8;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(102, 85, 26, 0.08);
    }

    .account-title {
        text-align: center;
        color: #66551A;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .account-subtitle {
        text-align: center;
        color: #8A7A45;
        margin-bottom: 28px;
    }

    .account-label {
        color: #66551A;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .account-input {
        width: 100%;
        height: 43px;
        border: 1px solid #D4B83F;
        border-radius: 7px;
        padding: 9px 12px;
        margin-bottom: 15px;
        outline: none;
    }

        .account-input:focus {
            border-color: #A98B12;
            box-shadow: 0 0 5px rgba(212, 184, 63, 0.3);
        }

    .account-button {
        width: 100%;
        background: #D4B83F;
        color: #3D3510;
        border: none;
        border-radius: 8px;
        padding: 13px;
        font-weight: 800;
        margin-top: 10px;
    }

        .account-button:hover {
            background: #A98B12;
            color: white;
        }

    .account-link {
        text-align: center;
        margin-top: 22px;
        color: #66551A;
    }

    .field-error {
        color: #B33A3A;
        font-size: 13px;
    }
</style>

<div class="account-page">
    <div class="account-card">

        <h2 class="account-title">TẠO TÀI KHOẢN</h2>
        <p class="account-subtitle">
            Tham gia MY STORE để trải nghiệm mua sắm
        </p>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "field-error" })

            <div>
                @Html.LabelFor(m => m.Username, new { @class = "account-label" })
                @Html.TextBoxFor(m => m.Username,
                    new { @class = "account-input", placeholder = "Nhập tên đăng nhập" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-error" })
            </div>

            <div>
                @Html.LabelFor(m => m.Password, new { @class = "account-label" })
                @Html.PasswordFor(m => m.Password,
                    new { @class = "account-input", placeholder = "Nhập mật khẩu" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
            </div>

            <div>
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "account-label" })
                @Html.PasswordFor(m => m.ConfirmPassword,
                    new { @class = "account-input", placeholder = "Nhập lại mật khẩu" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-error" })
            </div>

            <div>
                @Html.LabelFor(m => m.CustomerName, new { @class = "account-label" })
                @Html.TextBoxFor(m => m.CustomerName,
                    new { @class = "account-input", placeholder = "Nhập họ và tên" })
                @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "field-error" })
            </div>

            <div>
                @Html.LabelFor(m => m.CustomerPhone, new { @class = "account-label" })
                @Html.TextBoxFor(m => m.CustomerPhone,
                    new { @class = "account-input", placeholder = "Nhập số điện thoại" })
                @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "field-error" })
            </div>

            <div>
                @Html.LabelFor(m => m.CustomerEmail, new { @class = "account-label" })
                @Html.TextBoxFor(m => m.CustomerEmail,
                    new { @class = "account-input", placeholder = "Nhập email" })
                @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "field-error" })
            </div>

            <div>
                @Html.LabelFor(m => m.CustomerAddress, new { @class = "account-label" })
                @Html.TextBoxFor(m => m.CustomerAddress,
                    new { @class = "account-input", placeholder = "Nhập địa chỉ" })
            </div>

            <button type="submit" class="account-button">
                ĐĂNG KÝ NGAY
            </button>
        }

        <div class="account-link">
            Đã có tài khoản?
            <a href="@Url.Action("Login", "Account")">
                Đăng nhập
            </a>
        </div>

    </div>
</div>
