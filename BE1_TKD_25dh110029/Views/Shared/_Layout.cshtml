
@using System.Collections.Generic
@using BE1_TKD_25dh110029.Models

@{
    var categories = ViewBag.Categories as IEnumerable<Category>
                    ?? new List<Category>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - MY STORE</title>

    @Styles.Render("~/Content/css")

    <style>
        body {
            background: #FFFDF5;
            color: #66551A;
            margin: 0;
        }

        .top-banner {
            background: #3D3510;
            color: white;
            text-align: center;
            padding: 9px;
            font-size: 13px;
        }

        .store-header {
            background: #FFF8DF;
            border-bottom: 1px solid #E8D99B;
            padding: 18px 0;
        }

        .store-container {
            max-width: 1200px;
            margin: auto;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
        }

        .store-logo {
            font-size: 28px;
            font-weight: bold;
            color: #66551A;
            text-decoration: none;
        }

            .store-logo span {
                color: #C5A72E;
            }

        .store-menu {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 25px;
        }

            .store-menu a {
                color: #66551A;
                text-decoration: none;
                font-weight: 600;
            }

                .store-menu a:hover {
                    color: #A98B12;
                }

        .category-dropdown {
            position: relative;
        }

        .category-list {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            min-width: 190px;
            background: white;
            border: 1px solid #E8D99B;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,.1);
            z-index: 1000;
        }

        .category-dropdown:hover .category-list {
            display: block;
        }

        .category-list a {
            display: block;
            padding: 10px 15px;
        }

            .category-list a:hover {
                background: #FFF8DF;
            }
        .account-dropdown {
            position: relative;
        }

        .account-list {
            display: none;
            position: absolute;
            top: 100%;
            right: 0;
            min-width: 180px;
            background: white;
            border: 1px solid #E8D99B;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,.1);
            z-index: 1000;
            padding: 8px 0;
        }

        .account-dropdown:hover .account-list {
            display: block;
        }

        .account-list a {
            display: block;
            padding: 10px 15px;
            white-space: nowrap;
        }

            .account-list a:hover {
                background: #FFF8DF;
            }

        .store-content {
            max-width: 1200px;
            min-height: 500px;
            margin: auto;
            padding: 30px 20px;
        }

        .store-footer {
            background: #3D3510;
            color: white;
            padding: 30px 20px;
            text-align: center;
        }

        /* Căn chỉnh lại form đăng ký */
        .account-card {
            max-width: 520px;
            padding: 35px 40px;
        }

        .account-label {
            display: block;
            width: 100%;
            margin-bottom: 7px;
        }

        .account-input {
            display: block;
            width: 100%;
            height: 45px;
            box-sizing: border-box;
            margin-bottom: 18px;
        }

        .account-button {
            margin-top: 5px;
        }

        .field-error {
            display: block;
            margin-top: -12px;
            margin-bottom: 12px;
        }

        /* Căn chỉnh lại form đăng nhập */
        .login-card {
            max-width: 450px;
            padding: 38px 40px;
        }

        .login-label {
            display: block;
            width: 100%;
            margin-bottom: 7px;
        }

        .login-input {
            display: block;
            width: 100%;
            height: 45px;
            box-sizing: border-box;
            margin-bottom: 20px;
        }

        .login-button {
            margin-top: 18px;
        }

        .field-error {
            display: block;
            margin-top: -14px;
            margin-bottom: 12px;
        }

    </style>

    @RenderSection("styles", required: false)
</head>

<body>

    <div class="top-banner">
        MY STORE - MUA SẮM DỄ DÀNG - GIAO HÀNG TẬN NƠI
    </div>

    <header class="store-header">
        <div class="store-container">

            <a class="store-logo" href="@Url.Action("Index", "Home")">
                MY<span>STORE</span>
            </a>

            <nav class="store-menu">

                <a href="@Url.Action("Index", "Home")">
                    Trang chủ
                </a>

                <div class="category-dropdown">
                    <a href="@Url.Action("ProductList", "Home")">
                        Danh mục
                    </a>
                  
                    <div class="category-list">
                        @foreach (var category in categories)
                        {
                            <a href="@Url.Action("ProductList", "Home",
                                new { categoryId = category.CategoryID })">
                                @category.CategoryName
                            </a>
                        }
                    </div>
                </div>

                <a href="@Url.Action("ProductList", "Home")">
                    Sản phẩm
                </a>

                <div class="account-dropdown">
                    <a href="@Url.Action("Login", "Account")">
                        Tài khoản 
                    </a>

                    <div class="account-list">

                        @if (Session["Username"] == null)
                        {
                            <a href="@Url.Action("Login", "Account")">
                                Đăng nhập
                            </a>

                            <a href="@Url.Action("Register", "Account")">
                                Đăng ký tài khoản
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("ProfileInfo", "Account")">
                                Xin chào, @Session["Username"]
                            </a>
                            <a href="@Url.Action("MyOrders", "Account")">
                                Đơn hàng của tôi
                            </a>

                            <a href="@Url.Action("Logout", "Account")">
                                Đăng xuất
                            </a>
                        }

                    </div>
                </div>

                <a href="@Url.Action("Index", "Cart")">
                    <span class="glyphicon glyphicon-shopping-cart"></span>
                    Giỏ hàng
                </a>
                                     
            </nav>
        </div>
    </header>

    <main class="store-content">
        @RenderBody()
    </main>

    <footer class="store-footer">
        <h4>MY STORE</h4>
        <p>Website bán hàng trực tuyến</p>
        <p>© @DateTime.Now.Year MY STORE</p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>
