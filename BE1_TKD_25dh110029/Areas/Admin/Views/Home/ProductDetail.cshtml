
@model BE1_TKD_25dh110029.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .detail-title {
        background: #F3E5AB;
        color: #66551A;
        padding: 14px 18px;
        border-left: 5px solid #D4B83F;
        border-radius: 6px;
        font-size: 26px;
        font-weight: bold;
        margin: 10px 0 24px;
    }

    .detail-card {
        background: #FFFDF5;
        border: 1px solid #E8DCA8;
        border-radius: 10px;
        padding: 25px;
        color: #66551A;
        box-shadow: 0 4px 12px rgba(102, 85, 26, 0.08);
    }

    .detail-image {
        width: 100%;
        max-height: 380px;
        object-fit: contain;
        background: #FFFFFF;
        border: 1px solid #E8DCA8;
        border-radius: 8px;
        padding: 12px;
    }

    .detail-name {
        color: #66551A;
        font-size: 27px;
        font-weight: bold;
        margin-bottom: 18px;
    }

    .detail-price {
        color: #A98B12;
        font-size: 26px;
        font-weight: bold;
        margin: 18px 0;
    }

    .detail-info {
        padding: 12px 0;
        border-bottom: 1px solid #E8DCA8;
    }

    .detail-label {
        font-weight: bold;
        color: #66551A;
    }

    .detail-btn {
        display: inline-block;
        background: #D4B83F;
        color: #3D3510 !important;
        border: 1px solid #C5A72E;
        border-radius: 6px;
        padding: 9px 16px;
        margin: 12px 8px 0 0;
        text-decoration: none !important;
        font-weight: bold;
        transition: 0.2s;
    }

        .detail-btn:hover {
            background: #A98B12;
            color: white !important;
            transform: translateY(-2px);
        }

    @@media (max-width: 768px) {
        .detail-card {
            padding: 15px;
        }

        .detail-name {
            font-size: 22px;
        }
    }
</style>

<h2 class="detail-title">CHI TIẾT SẢN PHẨM</h2>

<div class="detail-card">
    <div class="row">
        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.ProductImage))
            {
                <img src="@Url.Content(Model.ProductImage)"
                     alt="@Model.ProductName"
                     class="detail-image" />
            }
            else
            {
                <div class="detail-image d-flex align-items-center justify-content-center">
                    Chưa có hình ảnh
                </div>
            }
        </div>

        <div class="col-md-7">
            <h3 class="detail-name">@Model.ProductName</h3>

            <div class="detail-info">
                <span class="detail-label">Mã sản phẩm:</span>
                @Model.ProductID
            </div>

            <div class="detail-price">
                @Html.DisplayFor(model => model.ProductPrice)
            </div>

            <div class="detail-info">
                <span class="detail-label">Danh mục:</span>
                @(Model.Category != null
                    ? Model.Category.CategoryName
                    : "Chưa phân loại")
            </div>

            <div class="detail-info">
                <span class="detail-label">Mô tả:</span>
                <p style="margin-top: 8px; white-space: pre-line;">
                    @Model.ProductDecription
                </p>
            </div>

            <div>
                @Html.ActionLink("← Quay lại", "Index", "Home",
                    null, new { @class = "detail-btn" })
            </div>
        </div>
    </div>
</div>

