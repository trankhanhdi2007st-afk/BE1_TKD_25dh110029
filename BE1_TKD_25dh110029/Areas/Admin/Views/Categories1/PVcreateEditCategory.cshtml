
@model BE1_TKD_25dh110029.Models.Category

@* Form con được nhúng vào Edit.cshtml và Create.cshtml *@

<style>
    .category-form-group {
        margin-bottom: 22px;
    }

    .category-form-label {
        color: #66551A;
        font-weight: 600;
        padding-top: 8px;
    }

    .category-form-control {
        border: 1px solid #D8C779;
        border-radius: 6px;
        background-color: #FFFFFF;
        color: #3D3510;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .category-form-control:focus {
            border-color: #D4B83F;
            box-shadow: 0 0 0 3px rgba(212, 184, 63, 0.2);
            outline: none;
        }

    .category-validation {
        display: block;
        margin-top: 5px;
        font-size: 13px;
    }
</style>

<div class="form-group category-form-group">
    <div class="control-label col-md-2 category-form-label">
        Tên Danh Mục
    </div>

    <div class="col-md-10">
        @Html.EditorFor(
            model => model.CategoryName,
            new
            {
                htmlAttributes = new
                {
                    @class = "form-control category-form-control",
                    placeholder = "Nhập tên danh mục..."
                }
            }
        )

        @Html.ValidationMessageFor(
            model => model.CategoryName,
            "",
            new { @class = "text-danger category-validation" }
        )
    </div>
</div>
