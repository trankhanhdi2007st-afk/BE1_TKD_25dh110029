
@model BE1_TKD_25dh110029.Models.Category

@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .category-edit-title {
        color: #66551A;
        font-weight: 700;
        padding-bottom: 12px;
        margin-bottom: 25px;
        border-bottom: 3px solid #D4B83F;
        text-transform: uppercase;
    }

    .category-edit-card {
        background-color: #FFFDF5;
        border: 1px solid #E8DCA8;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 12px rgba(102, 85, 26, 0.08);
    }

        .category-edit-card h4 {
            color: #66551A;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .category-edit-card hr {
            border-top: 1px solid #E8DCA8;
        }

        .category-edit-card .form-control {
            border: 1px solid #D8C779;
            border-radius: 6px;
            background-color: #FFFFFF;
            color: #3D3510;
        }

            .category-edit-card .form-control:focus {
                border-color: #D4B83F;
                box-shadow: 0 0 0 3px rgba(212, 184, 63, 0.2);
            }

    .category-edit-btn {
        display: inline-block;
        padding: 9px 20px;
        border: 1px solid #C5A72E;
        border-radius: 6px;
        background-color: #D4B83F;
        color: #3D3510 !important;
        font-weight: 600;
        text-decoration: none !important;
        transition: background-color 0.2s ease, color 0.2s ease;
        cursor: pointer;
    }

        .category-edit-btn:hover {
            background-color: #A98B12;
            color: #FFFFFF !important;
        }

    .category-edit-back {
        display: inline-block;
        margin-left: 8px;
        padding: 9px 20px;
        border: 1px solid #D8C779;
        border-radius: 6px;
        background-color: #FFF8DF;
        color: #66551A !important;
        font-weight: 600;
        text-decoration: none !important;
        transition: background-color 0.2s ease;
    }

        .category-edit-back:hover {
            background-color: #F3E5AB;
        }
</style>

<h2 class="category-edit-title">CẬP NHẬT DANH MỤC</h2>

<div class="category-edit-card">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <h4>Category</h4>
            <hr />

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.CategoryID)

            @Html.Partial("PVcreateEditCategory", Model)

            <div class="form-group" style="margin-top: 25px;">
                <button type="submit" class="category-edit-btn">
                    Lưu thay đổi
                </button>

                @Html.ActionLink(
                    "Quay lại danh sách",
                    "Index",
                    null,
                    new { @class = "category-edit-back" }
                )
            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
