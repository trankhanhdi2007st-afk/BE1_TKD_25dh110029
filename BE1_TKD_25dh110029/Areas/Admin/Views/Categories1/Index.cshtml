
@model IEnumerable<BE1_TKD_25dh110029.Models.Category>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .category-title {
        background-color: #F3E5AB;
        color: #66551A;
        padding: 12px 16px;
        border-left: 6px solid #D4B83F;
        border-radius: 6px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .category-table {
        width: 100%;
        background-color: #FFFDF5;
        color: #66551A;
        border-collapse: collapse;
        border: 1px solid #D4B83F;
    }

        .category-table th {
            background-color: #D4B83F;
            color: #3D3510;
            padding: 14px;
            text-align: center;
            border: 1px solid #C5A72E;
        }

        .category-table td {
            padding: 12px 15px;
            border: 1px solid #E8DCA8;
            vertical-align: middle;
        }

        .category-table tbody tr:nth-child(even) {
            background-color: #FFF8DF;
        }

        .category-table tbody tr:hover {
            background-color: #F9EDC0;
            transition: 0.2s;
        }

        .category-table td:first-child {
            font-weight: 600;
        }

    .category-actions {
        text-align: center;
        width: 260px;
        white-space: nowrap;
    }

    .category-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 78px;
        min-height: 36px;
        box-sizing: border-box;
        background-color: #D4B83F;
        color: #3D3510 !important;
        border: 1px solid #C5A72E;
        border-radius: 6px;
        padding: 7px 0;
        margin: 3px 2px;
        text-decoration: none !important;
        font-weight: 600;
        transition: all 0.25s ease;
    }

        .category-btn:hover {
            background-color: #A98B12;
            color: #FFFFFF !important;
            border-color: #A98B12;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(102, 85, 26, 0.25);
        }
</style>

<h2 class="category-title">
    DANH SÁCH DANH MỤC
</h2>

<table class="category-table">
    <thead>
        <tr>
            <th>Tên danh mục</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CategoryName)
                </td>

                <td class="category-actions">


                    @Html.ActionLink("Sửa", "Edit",
                        new { id = item.CategoryID },
                        new { @class = "category-btn" })
                    @Html.ActionLink("Chi tiết", "Details",
                        new { id = item.CategoryID },
                        new { @class = "category-btn" })
                    @Html.ActionLink("Xóa", "Delete",
                        new { id = item.CategoryID },
                        new { @class = "category-btn" })
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="category-create">
    @Html.ActionLink("＋ Thêm mới", "Create", null,
        new
            {
            @class = "category-btn",
            style = "width: 140px; white-space: nowrap;"
        })
</div>
