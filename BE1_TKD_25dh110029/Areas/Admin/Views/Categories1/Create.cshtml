```cshtml
@model BE1_TKD_25dh110029.Models.Category

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .category-create-title {
        background-color: #F3E5AB;
        color: #66551A;
        padding: 12px 16px;
        border-left: 6px solid #D4B83F;
        border-radius: 6px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .category-create-form {
        background-color: #FFFDF5;
        border: 1px solid #E8DCA8;
        border-radius: 8px;
        padding: 20px;
        color: #3D3510;
    }

        .category-create-form h4 {
            color: #66551A;
            font-weight: bold;
        }

        .category-create-form hr {
            border-top: 1px solid #E8DCA8;
        }

        .category-create-form .form-control {
            border: 1px solid #D9C77A;
            border-radius: 5px;
            box-shadow: none;
        }

            .category-create-form .form-control:focus {
                border-color: #C5A72E;
                box-shadow: 0 0 0 2px rgba(212, 184, 63, 0.2);
            }

    .category-create-back {
        display: inline-block;
        margin-top: 15px;
        padding: 7px 14px;
        background-color: #D4B83F;
        color: #3D3510 !important;
        border: 1px solid #C5A72E;
        border-radius: 5px;
        text-decoration: none !important;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .category-create-back:hover {
            background-color: #A98B12;
            color: #FFFFFF !important;
        }
</style>

<h2 class="category-create-title">THÊM SẢN PHẨM</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal category-create-form">
        <h4>Product</h4>
        <hr />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.Partial("PVcreateEditCategory", Model)
    </div>
}

<div>
    @Html.ActionLink(
        "Back to List",
        "Index",
        null,
        new { @class = "category-create-back" }
    )
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
```