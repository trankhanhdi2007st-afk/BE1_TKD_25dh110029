
@model BE1_TKD_25dh110029.Models.Category

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .category-details-title {
        background-color: #F3E5AB;
        color: #66551A;
        padding: 12px 16px;
        border-left: 6px solid #D4B83F;
        border-radius: 6px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .category-details-card {
        background-color: #FFFDF5;
        color: #3D3510;
        border: 1px solid #E8DCA8;
        border-radius: 8px;
        padding: 22px;
        box-shadow: 0 4px 12px rgba(102, 85, 26, 0.08);
    }

    .category-details-subtitle {
        color: #66551A;
        font-weight: bold;
        margin-top: 0;
    }

    .category-details-card hr {
        border-top: 1px solid #E8DCA8;
    }

    .category-details-card dt {
        color: #66551A;
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .category-details-card dd {
        background-color: #FFF8DF;
        border: 1px solid #E8DCA8;
        border-radius: 5px;
        padding: 10px 14px;
        margin-bottom: 15px;
        min-height: 40px;
    }

    .category-details-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 20px;
    }

    .category-details-btn {
        display: inline-block;
        padding: 8px 16px;
        background-color: #D4B83F;
        color: #3D3510 !important;
        border: 1px solid #C5A72E;
        border-radius: 5px;
        text-decoration: none !important;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .category-details-btn:hover {
            background-color: #A98B12;
            color: #FFFFFF !important;
            border-color: #A98B12;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(102, 85, 26, 0.2);
        }
</style>

<h2 class="category-details-title">
    THÔNG TIN CHI TIẾT CỦA DANH MỤC
</h2>

<div class="category-details-card">
    <h4 class="category-details-subtitle">Thông tin danh mục</h4>
    <hr />

    <dl class="dl-horizontal">
        <dt>TÊN DANH MỤC</dt>
        <dd>
            @Html.DisplayFor(model => model.CategoryName)
        </dd>
    </dl>

    <div class="category-details-actions">
        @Html.ActionLink(
            "Cập nhật",
            "Edit",
            new { id = Model.CategoryID },
            new { @class = "category-details-btn" }
        )

        @Html.ActionLink(
            "Quay lại danh sách",
            "Index",
            null,
            new { @class = "category-details-btn" }
        )
    </div>
</div>
