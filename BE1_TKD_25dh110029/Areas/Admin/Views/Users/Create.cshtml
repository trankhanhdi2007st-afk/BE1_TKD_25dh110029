@{
    ViewBag.Title = "Thêm tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .user-form {
        background: #FFFDF5;
        padding: 28px;
        border-radius: 14px;
        max-width: 650px;
        color: #66551A;
    }

    .user-form {
        background: #FFFDF5;
        padding: 28px;
        border-radius: 14px;
        max-width: 520px;
        color: #66551A;
    }

        .user-form label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #66551A;
        }

        .user-form input,
        .user-form select {
            display: block;
            box-sizing: border-box;
            width: 100%;
            max-width: 100%;
            height: 44px;
            border: 1px solid #E8D99B;
            border-radius: 8px;
            padding: 10px 13px;
            margin-bottom: 20px;
            background: #FFFFFF;
        }

            .user-form input:focus,
            .user-form select:focus {
                outline: none;
                border-color: #C5A72E;
                box-shadow: 0 0 0 3px rgba(197, 167, 46, 0.15);
            }

    .btn-gold {
        background: #C5A72E;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 7px;
    }

        .btn-gold:hover {
            background: #A98B12;
        }

    .error-text {
        color: #B44432;
        margin-bottom: 15px;
    }

</style>

<div class="user-form">
    <h2>THÊM TÀI KHOẢN</h2>

    @using (Html.BeginForm("Create", "Users", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        if (ViewBag.ErrorMessage != null)
        {
            <p class="error-text">@ViewBag.ErrorMessage</p>
        }

        <label>Tên đăng nhập</label>
        <input type="text" name="username"
               placeholder="Nhập tên đăng nhập" required />

        <label>Mật khẩu</label>
        <input type="password" name="password"
               placeholder="Nhập mật khẩu" required />

        <label>Vai trò</label>
        <select name="userRole" required>
            <option value="">-- Chọn vai trò --</option>
            <option value="A">Admin (A)</option>
            <option value="C">Customer (C)</option>
        </select>

        <button type="submit" class="btn-gold">Lưu tài khoản</button>

        @Html.ActionLink("Quay lại", "Index", null,
            new { @class = "btn btn-default" })
    }
</div>
