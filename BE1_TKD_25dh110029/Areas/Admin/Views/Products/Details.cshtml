
@model BE1_TKD_25dh110029.Models.Product

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .product-details-page {
        margin: 25px auto;
        padding: 0 15px;
        color: #3D3510;
    }

    .product-details-title {
        background-color: #F3E5AB;
        color: #66551A;
        padding: 16px 20px;
        border-left: 6px solid #D4B83F;
        border-radius: 7px;
        margin-bottom: 25px;
        font-weight: bold;
    }

    .product-details-card {
        background-color: #FFFDF5;
        border: 1px solid #E8DCA8;
        border-radius: 10px;
        padding: 25px;
        box-shadow: 0 4px 12px rgba(102, 85, 26, 0.08);
    }

    .product-details-actions {
        margin-top: 25px;
        padding-top: 18px;
        border-top: 1px solid #E8DCA8;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .product-details-btn {
        display: inline-block;
        min-width: 90px;
        padding: 8px 16px;
        text-align: center;
        background-color: #D4B83F;
        color: #3D3510 !important;
        border: 1px solid #C5A72E;
        border-radius: 5px;
        text-decoration: none !important;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .product-details-btn:hover {
            background-color: #A98B12;
            color: #FFFFFF !important;
            border-color: #A98B12;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(102, 85, 26, 0.2);
        }
</style>

<div class="product-details-page">
    <h2 class="product-details-title">
        CHI TIẾT SẢN PHẨM
    </h2>

    <div class="product-details-card">
        @Html.Partial("PVProdInfo", Model)

        <div class="product-details-actions">
            @Html.ActionLink(
                "Sửa",
                "Edit",
                new { id = Model.ProductID },
                new { @class = "product-details-btn" }
            )

            @Html.ActionLink(
                "Quay lại danh sách",
                "Index",
                null,
                new { @class = "product-details-btn" }
            )
        </div>
    </div>
</div>
