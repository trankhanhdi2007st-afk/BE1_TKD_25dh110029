@model BE1_TKD_25dh110029.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .product-title {
        background-color: #F3E5AB;
        color: #66551A;
        padding: 12px 16px;
        border-left: 6px solid #D4B83F;
        border-radius: 6px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .product-table {
        width: 100%;
        background-color: #FFFDF5;
        color: #66551A;
        border-collapse: collapse;
        border: 1px solid #D4B83F;
    }

        .product-table th {
            background-color: #D4B83F;
            color: #3D3510;
            padding: 12px;
            text-align: center;
            border: 1px solid #C5A72E;
        }

        .product-table td {
            padding: 12px;
            vertical-align: middle;
            border: 1px solid #E8DCA8;
        }

        .product-table tbody tr:nth-child(even) {
            background-color: #FFF8DF;
        }

        .product-table tbody tr:hover {
            background-color: #F9EDC0;
            transition: 0.2s;
        }

    .product-image {
        width: 100px;
        height: 100px;
        object-fit: contain;
        border-radius: 8px;
        background-color: white;
        border: 1px solid #E8DCA8;
        padding: 4px;
    }

    .product-btn {
        display: inline-block;
        background-color: #D4B83F;
        color: #3D3510 !important;
        border: none;
        border-radius: 5px;
        padding: 7px 12px;
        margin: 3px;
        text-decoration: none !important;
        font-weight: 600;
        transition: all 0.25s ease;
    }

        .product-btn:hover {
            background-color: #A98B12;
            color: #FFFFFF !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(102, 85, 26, 0.25);
        }

    .product-actions {
        text-align: center;
        min-width: 220px;
    }

    .product-price {
        font-weight: bold;
        white-space: nowrap;
    }

    .product-create {
        margin-top: 20px;
    }
</style>

<h2 class="product-title">
    DANH SÁCH SẢN PHẨM
</h2>

@using (Html.BeginForm("Index", "Products", FormMethod.Get))
{
    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:20px; align-items:end;">

        <div>
            <label>Tên sản phẩm</label>
            @Html.TextBoxFor(m => m.SearchTerm, new
            {
                @class = "form-control",
                placeholder = "Nhập tên sản phẩm..."
            })
        </div>

        <div>
            <label>Giá từ</label>
            @Html.TextBoxFor(m => m.MinPrice, new
            {
                @class = "form-control",
                type = "number",
                min = "0",
                placeholder = "Giá thấp nhất"
            })
        </div>

        <div>
            <label>Giá đến</label>
            @Html.TextBoxFor(m => m.MaxPrice, new
            {
                @class = "form-control",
                type = "number",
                min = "0",
                placeholder = "Giá cao nhất"
            })
        </div>

        <div>
            <label>Sắp xếp</label>
            @Html.DropDownListFor(m => m.SortOrder,
                new SelectList(new[]
                {
                    new SelectListItem { Text = "Tên A - Z", Value = "name_asc" },
                    new SelectListItem { Text = "Tên Z - A", Value = "name_desc" },
                    new SelectListItem { Text = "Giá thấp đến cao", Value = "price_asc" },
                    new SelectListItem { Text = "Giá cao đến thấp", Value = "price_desc" }
                }, "Value", "Text", Model.SortOrder),
                "Mặc định",
                new { @class = "form-control" })
        </div>

        <div>
            <button type="submit" class="product-btn">Tìm kiếm</button>
            @Html.ActionLink("Làm mới", "Index", null,
                new { @class = "product-btn" })
        </div>

    </div>
}


<table class="product-table">
    <thead>
        <tr>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Đơn giá</th>
            <th>Danh mục</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Products)

        {
            <tr>
                <td style="text-align: center;">
                    @if (!string.IsNullOrEmpty(item.ProductImage))
                    {
                        <img src="@Url.Content(item.ProductImage)"
                             alt="@item.ProductName"
                             class="product-image" />
                    }
                    else
                    {
                        <span>Chưa có ảnh</span>
                    }
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.ProductName)
                </td>

                <td class="product-price">
                    @Html.DisplayFor(modelItem => item.ProductPrice)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Category.CategoryName)
                </td>

                <td class="product-actions">
                    @Html.ActionLink("Sửa", "Edit",
                        new { id = item.ProductID },
                        new { @class = "product-btn" })

                    @Html.ActionLink("Chi tiết", "Details",
                        new { id = item.ProductID },
                        new { @class = "product-btn" })

                    @Html.ActionLink("Xóa", "Delete",
                        new { id = item.ProductID },
                        new { @class = "product-btn" })
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="text-center mt-3">
    @if (Model.Products.HasPreviousPage)
    {
        @Html.ActionLink("« Trang trước", "Index",
            new
            {
                page = Model.Products.PageNumber - 1,
                searchTerm = Model.SearchTerm,
                minPrice = Model.MinPrice,
                maxPrice = Model.MaxPrice,
                sortOrder = Model.SortOrder
            },
            new { @class = "product-btn" })
    }

    <span style="margin: 0 12px;">
        Trang @Model.Products.PageNumber / @Model.Products.PageCount
    </span>

    @if (Model.Products.HasNextPage)
    {
        @Html.ActionLink("Trang sau »", "Index",
            new
            {
                page = Model.Products.PageNumber + 1,
                searchTerm = Model.SearchTerm,
                minPrice = Model.MinPrice,
                maxPrice = Model.MaxPrice,
                sortOrder = Model.SortOrder
            },
            new { @class = "product-btn" })
    }
</div>

<div class="product-create">
    @Html.ActionLink("＋ Thêm mới", "Create", null,
        new { @class = "product-btn" })
</div>

